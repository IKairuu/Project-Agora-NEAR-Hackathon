# Copy to .env. Every value is optional: with none set, the app runs the scripted demo and simulated sign-in.

# The dev server sends /api to http://localhost:3000. To use another API, set AGORA_API_URL in the shell
# (Vite reads it from the environment, not from this file), for example the hosted API:
#   AGORA_API_URL=https://agora-backend-production-09f1db08.up.railway.app npm run dev

# Supabase: Project Settings > API. Needed for real sign-in (Google, GitHub, email, NEAR wallet).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEAR. Defaults to testnet and the public RPCs.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=
VITE_NEAR_RPC_URLS=
